# Local Python / experiment artefacts — never commit secrets or generated dumps
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Environment and API keys
.env
.env.*
!.env.example
secrets/

# OS / editor
.DS_Store
Thumbs.db
*.swp

# Downloaded or generated datasets (keep README and seed lists)
data/raw/
data/generated/
data/cache/

# Experiment outputs (commit only curated tables under results/tables if needed)
results/runs/
results/tmp/
*.log

# Scanner / LLM caches
.bandit
.semgrep/
.cache/
