{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Secret Vault",
  "version": "2.6.1",
  "identifier": "com.secretvault.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Secret Vault v2.6.1",
        "width": 1180,
        "height": 760,
        "minWidth": 920,
        "minHeight": 600,
        "resizable": true,
        "transparent": true,
        "backgroundColor": [0, 0, 0, 0]
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "installers/**/*"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMyQzdGRUQ4QzI1NjZEOUIKUldTYmJWYkMyUDdId29BQzZUVDAxR3NBVUtienIzSWxmOWM3U2ExOWtvVTdTRmlRSHptOVNkQ3EK",
      "endpoints": [
        "https://github.com/Ushangallage2/secretVault/releases/latest/download/latest.json"
      ]
    }
  }
}
